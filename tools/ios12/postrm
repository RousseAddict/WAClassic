#!/bin/sh
# WA Classic iOS 12 build: drop the icon after removal. The data folder
# /var/mobile/Library/WA4S (log, assets, settings) is kept, like the original package.
if [ "$1" = remove ] || [ "$1" = purge ]; then
  uicache -u /Applications/WA4S.app 2>/dev/null || uicache -a 2>/dev/null || true
fi
exit 0
